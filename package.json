{
  "name": "chatter",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test:crypto": "tsx --tsconfig tsconfig.test.json src/services/crypto/__tests__/run.ts && tsx --tsconfig tsconfig.test.json src/services/crypto/__tests__/recovery.ts",
    "check": "tsc -p tsconfig.check.json",
    "test:services": "tsx --tsconfig tsconfig.test.json src/services/__tests__/run.ts",
    "test": "npm run test:crypto && npm run test:services && npm run test:components",
    "test:components": "jest"
  },
  "dependencies": {
    "@noble/hashes": "^1.4.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.3.1",
    "@react-native-firebase/app": "^20.1.0",
    "@react-native-firebase/auth": "^20.1.0",
    "@react-native-firebase/firestore": "^20.1.0",
    "@react-native-firebase/messaging": "^20.1.0",
    "@react-native-firebase/storage": "^20.1.0",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "date-fns": "^3.6.0",
    "expo": "~51.0.0",
    "expo-av": "~14.0.6",
    "expo-crypto": "~13.0.2",
    "expo-file-system": "~17.0.1",
    "expo-image-picker": "~15.0.7",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-keychain": "^8.2.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "tweetnacl": "^1.0.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "babel-plugin-module-resolver": "^5.0.2",
    "tsx": "^4.19.2",
    "typescript": "~5.3.3",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.12",
    "jest": "^29.2.1",
    "jest-expo": "~51.0.0",
    "react-test-renderer": "18.2.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-native-firebase|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|zustand)/)"
    ]
  }
}
