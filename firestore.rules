rules_version = '2';

// Chatter security rules.
//
// The guiding principle: the database is untrusted infrastructure. Message
// contents are end-to-end encrypted, so these rules only need to protect
// *who* can read/write *which* documents — not the plaintext (the server never
// has it).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // --- Users --------------------------------------------------------------
    match /users/{uid} {
      // Any signed-in user may read a profile (needed to start a chat and to
      // resolve names). Only the owner may write it.
      allow read: if isSignedIn();
      allow create, update: if isSelf(uid);
      allow delete: if isSelf(uid);

      // One-time prekeys: readable by signed-in users (senders pick one to start a
      // session — there is no server-side function on the free plan); writable
      // (published / deleted once used) only by the owner.
      match /prekeys/{keyId} {
        allow read: if isSignedIn();
        allow write: if isSelf(uid);
      }

      // Device tokens are private to the owner.
      match /devices/{deviceId} {
        allow read, write: if isSelf(uid);
      }

      // Saved contacts. Private to their owner — a profile document is readable
      // by anyone signed in (that is how username search works), so keeping
      // contacts on the profile would publish who you know.
      match /contacts/{contactId} {
        allow read, write: if isSelf(uid);
      }

      // Password-wrapped history key (see services/historyKey.ts). Only ciphertext
      // lives here, and only its owner can touch it.
      match /backup/{docId} {
        allow read, write: if isSelf(uid);
      }

      // Private material must never be synced; deny by default.
      match /private/{docId} {
        allow read, write: if false;
      }

      // Block list: private to the owner. Nobody else can read who you
      // blocked — that is what makes the direct-chat send checks below
      // safe to enforce on the server without leaking the block itself.
      match /blocks/{blockedId} {
        allow read, write: if isSelf(uid);
      }

      // Per-chat preferences (pin / mute / star / mark-unread). Private to
      // the owner, like the block list — a pin must never pin for everyone.
      match /chatPrefs/{chatId} {
        allow read, write: if isSelf(uid);
      }
    }

    // --- Usernames ----------------------------------------------------------
    // A handle is a single document { uid }. Anyone signed in can read it
    // (that's how search and the availability check work); you can only claim
    // or release a handle that belongs to you.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // --- Abuse reports ------------------------------------------------------
    // Write-only: anyone signed in may file one, and the reporter must be
    // themselves. Nobody can read, change or delete reports — there is no
    // admin console yet, so reports are stored for future moderation and
    // are not acted on automatically.
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // --- Chats --------------------------------------------------------------
    match /chats/{chatId} {
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.memberIds;
      }

      // You can read a chat you're in — or one that does not exist yet.
      //
      // `resource == null` means the document is absent. The app deliberately
      // reads a direct chat before creating it, to find out whether it already
      // exists; without this clause that read is denied, and starting a new
      // conversation fails with "You don't have permission to do that".
      // Allowing a read of a non-existent document reveals nothing, because
      // there is nothing there.
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.memberIds);

      // Creating a chat: you must include yourself as a member. A direct
      // chat cannot be created with someone who blocked you — the other
      // member is the one who isn't you. Group creates skip the check
      // (short-circuit: the function is only evaluated for direct chats).
      function directPeerBlocked() {
        let members = request.resource.data.memberIds;
        let other = members[0] == request.auth.uid ? members[1] : members[0];
        return exists(/databases/$(database)/documents/users/$(other)/blocks/$(request.auth.uid));
      }
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberIds &&
        (request.resource.data.kind != 'direct' || !directPeerBlocked());

      // Updating: split by what actually changed, so membership power is
      // enforced on the server instead of trusting the client.
      //
      // Any member may always:
      //   - move their OWN read cursor forward (never backwards, never
      //     anyone else's cursor),
      //   - refresh the list preview (senders do this on every message),
      //   - hide the chat for themselves,
      //   - leave the group (removing only themselves from memberIds/adminIds),
      //   - ADD members (collaborative by product intent — see GroupInfoScreen).
      // Anything else (removing other members, promoting, renaming, changing
      // the photo) needs an admin — except in legacy chats that have no
      // adminIds field, where today's behaviour is preserved so old clients
      // and old groups keep working. Groups created by current clients always
      // carry adminIds (createGroup sets the creator as admin).
      function isAdmin() {
        return isSignedIn() && (
          !('adminIds' in resource.data) || request.auth.uid in resource.data.adminIds
        );
      }
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function cursorOnlyForward() {
        let cursorDiff = request.resource.data.get('lastReadAt', {})
          .diff(resource.data.get('lastReadAt', {})).affectedKeys();
        return changed().hasOnly(['lastReadAt']) &&
          cursorDiff.hasOnly([request.auth.uid]) &&
          request.resource.data.get('lastReadAt', {}).get(request.auth.uid, 0) >=
          resource.data.get('lastReadAt', {}).get(request.auth.uid, 0);
      }
      function previewOnly() {
        return changed().hasOnly(['lastMessageAt', 'lastMessagePreview', 'lastMessageId', 'updatedAt']);
      }
      function hideOnly() {
        return changed().hasOnly(['hiddenFor', 'updatedAt']) &&
          request.resource.data.get('hiddenFor', {})
            .diff(resource.data.get('hiddenFor', {})).affectedKeys().hasOnly([request.auth.uid]);
      }
      function selfLeave() {
        return changed().hasOnly(['memberIds', 'adminIds', 'updatedAt']) &&
          request.resource.data.memberIds.toSet()
            .difference(resource.data.memberIds.toSet()).size() == 0 &&
          resource.data.memberIds.toSet()
            .difference(request.resource.data.memberIds.toSet()).hasOnly([request.auth.uid]) &&
          request.resource.data.get('adminIds', []).toSet()
            .difference(resource.data.get('adminIds', []).toSet()).size() == 0 &&
          resource.data.get('adminIds', []).toSet()
            .difference(request.resource.data.get('adminIds', []).toSet()).hasOnly([request.auth.uid]);
      }
      function membersOnlyGrew() {
        let oldMembers = resource.data.memberIds.toSet();
        let newMembers = request.resource.data.memberIds.toSet();
        let added = newMembers.difference(oldMembers);
        let cursorDiff = request.resource.data.get('lastReadAt', {})
          .diff(resource.data.get('lastReadAt', {})).affectedKeys();
        return changed().hasOnly(['memberIds', 'lastReadAt', 'updatedAt']) &&
          oldMembers.difference(newMembers).size() == 0 &&
          added.size() > 0 &&
          cursorDiff.difference(added).size() == 0;
      }
      // Any member may set the disappearing-message timer (off / 24h / 7d /
      // 90d). Nothing else may change in the same write.
      function ttlOnly() {
        return changed().hasOnly(['defaultEphemeralTtlMs', 'updatedAt']) &&
          request.resource.data.defaultEphemeralTtlMs in [0, 86400000, 604800000, 7776000000];
      }
      allow update: if isMember() &&
        (cursorOnlyForward() || previewOnly() || hideOnly() || selfLeave() ||
         membersOnlyGrew() || ttlOnly() || isAdmin());

      // Deleting the whole chat doc: admins only (legacy chats keep today's
      // any-member behaviour, since they have no adminIds to check).
      allow delete: if isAdmin();

      // Messages: any member may read; only the sender may create.
      match /messages/{messageId} {
        function chatMember() {
          return isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        }

        allow read: if chatMember();
        // A direct message cannot be sent to someone who blocked you. The
        // recipient is the chat member who isn't you; group messages skip
        // the check (group moderation is removeMember, not blocks). The
        // chat get() here is the same one chatMember() already did, so it
        // costs nothing extra — rules dedupe gets within one request.
        function directRecipientBlocked() {
          let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
          let other = chat.memberIds[0] == request.auth.uid ? chat.memberIds[1] : chat.memberIds[0];
          return chat.kind == 'direct' &&
            exists(/databases/$(database)/documents/users/$(other)/blocks/$(request.auth.uid));
        }
        allow create: if chatMember() && request.resource.data.senderId == request.auth.uid && !directRecipientBlocked();
        function rank(s) {
          return s == 'read' ? 3 : (s == 'delivered' ? 2 : 1);
        }
        function changed() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }
        // A recipient may only raise THEIR OWN receipt (sent -> delivered -> read).
        function ownReceiptForward() {
          return changed().hasOnly(['receipts']) &&
            request.resource.data.receipts.diff(resource.data.receipts).affectedKeys().hasOnly([request.auth.uid]) &&
            rank(request.resource.data.receipts[request.auth.uid]) >= rank(resource.data.receipts.get(request.auth.uid, 'sent'));
        }
        // The sender may swap in re-encrypted envelopes (answering a resend request).
        // Never for a tombstoned message: re-adding envelopes would resurrect
        // content the sender already deleted for everyone.
        function senderResend() {
          return request.auth.uid == resource.data.senderId &&
            resource.data.deletedForEveryone != true &&
            changed().hasOnly(['envelopes', 'selfEnvelope']);
        }
        // The sender may tombstone their own message (delete for everyone):
        // blank the envelopes, history copy and media descriptor, and flag it.
        // This is the only way content leaves the server; the document itself
        // stays so the conversation keeps its place and a tombstone renders.
        function senderTombstone() {
          return request.auth.uid == resource.data.senderId &&
            request.resource.data.deletedForEveryone == true &&
            changed().hasOnly(['deletedForEveryone', 'deletedAt', 'envelopes', 'selfEnvelope', 'media']);
        }

        // The sender may edit their own message (re-encrypted envelopes +
        // editedAt). Never a tombstoned message: editing one would resurrect
        // content deleted for everyone. The 15-minute window is
        // client-enforced — createdAt is a millisecond number, so the rules
        // cannot compare it to request.time.
        function senderEdit() {
          return request.auth.uid == resource.data.senderId &&
            resource.data.deletedForEveryone != true &&
            changed().hasOnly(['envelopes', 'selfEnvelope', 'editedAt']);
        }

        allow update: if chatMember() && (ownReceiptForward() || senderResend() || senderTombstone() || senderEdit());
        allow delete: if isSignedIn() &&
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)/messages/$(messageId)).data.senderId;
      }

      // Reactions: any chat member may read all reactions and write their own.
      match /messages/{messageId}/reactions/{uid} {
        function chatMember() {
          return isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        }
        allow read: if chatMember();
        allow write: if chatMember() && request.auth.uid == uid;
      }

      // Poll votes: any chat member may read all votes and write their own.
      match /messages/{messageId}/votes/{uid} {
        function chatMember() {
          return isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        }
        allow read: if chatMember();
        allow write: if chatMember() && request.auth.uid == uid;
      }

      // Resend requests: a recipient who can't read a message asks its sender to
      // re-encrypt it. Either party may read and clear the request.
      match /resendRequests/{requestId} {
        function chatMember() {
          return isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        }
        allow read: if chatMember();
        allow create, update: if chatMember() && request.resource.data.requesterUid == request.auth.uid;
        allow delete: if chatMember() &&
          (resource.data.requesterUid == request.auth.uid || resource.data.senderUid == request.auth.uid);
      }

      // Typing indicators: any member may read/write their own entry.
      match /typing/{uid} {
        function chatMember() {
          return isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        }
        allow read: if chatMember();
        allow write: if chatMember() && request.auth.uid == uid;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
